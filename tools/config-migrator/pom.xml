<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.andrei1058.bedwars.tools</groupId>
    <artifactId>bedwars-config-migrator</artifactId>
    <version>2.3.0</version>
    <properties><maven.compiler.release>21</maven.compiler.release><maven.compiler.fork>true</maven.compiler.fork><project.build.sourceEncoding>UTF-8</project.build.sourceEncoding></properties>
    <dependencies>
        <dependency><groupId>org.yaml</groupId><artifactId>snakeyaml</artifactId><version>2.2</version></dependency>
        <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><version>5.11.4</version><scope>test</scope></dependency>
    </dependencies>
    <build><plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.5.0</version>
                <executions><execution><id>require-java25-build</id><goals><goal>enforce</goal></goals>
                    <configuration><rules><requireJavaVersion>
                        <version>[25,26)</version>
                        <message>构建和验证仅允许 Java 25；字节码目标仍为 Java 21。请将 JAVA_HOME 指向 JDK 25。</message>
                    </requireJavaVersion></rules></configuration>
                </execution></executions>
            </plugin>

        <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-shade-plugin</artifactId><version>3.5.3</version><executions><execution><phase>package</phase><goals><goal>shade</goal></goals><configuration><createDependencyReducedPom>false</createDependencyReducedPom><transformers><transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer"><mainClass>com.andrei1058.bedwars.tools.ConfigMigrator</mainClass></transformer></transformers></configuration></execution></executions></plugin>
    </plugins></build>
</project>
